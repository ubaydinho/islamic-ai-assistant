# ============================================================
# Islamic AI Assistant — Environment Variables Template
# ============================================================
# Salin file ini ke .env dan isi nilai yang sesuai:
#   cp .env.example .env
# JANGAN commit file .env ke repository!
# ============================================================

# Groq API Key — dapatkan gratis di https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model configuration
GROQ_MODEL_PRIMARY=llama-3.1-8b-instant
GROQ_MODEL_FALLBACK=gemma2-9b-it
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3

# ChromaDB connection
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# Application security — ganti dengan nilai random yang kuat
SECRET_KEY=change-this-to-random-secret-key

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Confidence threshold untuk menerima respons LLM tanpa disclaimer
CONFIDENCE_THRESHOLD=0.6

# SQLite database path (di dalam volume Docker)
SQLITE_PATH=/data/sessions.db

# HuggingFace model cache directory (di dalam volume Docker)
HF_HOME=/models
